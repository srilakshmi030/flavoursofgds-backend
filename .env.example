# Server
PORT=4000
NODE_ENV=development

# CORS
# The origin the front end is served from. In a sandbox or Intune-delivered
# build this is not localhost - set it to the real host.
CORS_ORIGIN=http://localhost:3000

# Azure Blob Storage container holding city photos and videos.
# Example: https://<storage-account>.blob.core.windows.net/media
BLOB_BASE_URL=

# PostgreSQL (docker-compose.yml reads these too)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flavoursofgds
DB_USER=flavours
DB_PASSWORD=<set-a-local-password>
# true for Azure Database for PostgreSQL, false for local Docker
DB_SSL=false

# Microsoft Entra ID (Azure AD) - fill these in from your App Registration
ENTRA_TENANT_ID=<your-tenant-id>
ENTRA_CLIENT_ID=<your-client-id>
ENTRA_CLIENT_SECRET=<your-client-secret>
# Audience your Entra ID access tokens are issued for (usually api://<client-id> or the client id itself)
ENTRA_AUDIENCE=<your-api-audience>
ENTRA_ISSUER=https://login.microsoftonline.com/<your-tenant-id>/v2.0

# App-issued JWT (used for subsequent API calls after SSO login)
JWT_SECRET=<replace-with-a-long-random-secret>
JWT_EXPIRES_IN=1h

# Test-app only convenience login. Leave unset in production - the endpoint
# returns 404 when this is empty or NODE_ENV=production.
DEV_LOGIN_PASSWORD=
