{
  "name": "flavoursofgds-backend",
  "version": "1.0.0",
  "description": "FlavoursOfGDS backend - Node.js/Express API with Microsoft Entra ID SSO and JWT-based auth",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "content:workbook": "node scripts/generate-city-media-workbook.js blr",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "node scripts/seed.js blr"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "exceljs": "^4.4.0",
    "nodemon": "^3.1.4"
  }
}
